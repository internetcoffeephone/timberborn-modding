<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SequencedKeys</AssemblyName>
    <RootNamespace>SequencedKeys</RootNamespace>
  </PropertyGroup>

  <!--
    To build this mod you need to set GameManagedPath to point to:
      <Timberborn Install>/Timberborn_Data/Managed
    Either pass it as a property or edit the path below.
  -->
  <PropertyGroup>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(HOME)/.steam/steam/steamapps/common/Timberborn/Timberborn_Data/Managed</GameManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Timberborn.CoreUI">
      <HintPath>$(GameManagedPath)/Timberborn.CoreUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.UILayoutSystem">
      <HintPath>$(GameManagedPath)/Timberborn.UILayoutSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.SingletonSystem">
      <HintPath>$(GameManagedPath)/Timberborn.SingletonSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.InputSystem">
      <HintPath>$(GameManagedPath)/Timberborn.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.KeyBindingSystem">
      <HintPath>$(GameManagedPath)/Timberborn.KeyBindingSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.BottomBarSystem">
      <HintPath>$(GameManagedPath)/Timberborn.BottomBarSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.ToolSystem">
      <HintPath>$(GameManagedPath)/Timberborn.ToolSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.ToolButtonSystem">
      <HintPath>$(GameManagedPath)/Timberborn.ToolButtonSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.Common">
      <HintPath>$(GameManagedPath)/Timberborn.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Timberborn.Localization">
      <HintPath>$(GameManagedPath)/Timberborn.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Bindito.Core">
      <HintPath>$(GameManagedPath)/Bindito.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManagedPath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(GameManagedPath)/UnityEngine.UIElementsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(GameManagedPath)/Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
